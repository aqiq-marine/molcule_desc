# molcule_desc parser input fixtures
#
# Purpose:
#   Parser-level examples for the proposed surface syntax. These are syntax
#   fixtures, not semantic or chemical-validity tests.
#
# Syntax represented here:
#   - Position labels are numeric only.
#   - A host fragment exposes a function as fragment.f.
#   - Calls have exactly two groups:
#       host.f {bond connections} {published ports}
#   - The first group connects host ports to guest ports. Port paths include
#     bond type and index, e.g. s.1: guest.port.s.1 or d.1: guest2.port.d.2.
#   - The second group publishes ports by mapping a public port path to an
#     internal path, e.g. s.1: 0.s.2.
#   - In an internal path, 0 denotes the host; a path such as s.1.s.1
#     traverses through the guest attached at host port s.1.
#   - ring(structure, position_a, position_b) is a proposed syntax for
#     connecting two ports within one structure.
#
# Names such as ethane, benzene, OH, and fragment are unresolved identifiers
# from the parser's point of view.

# 1. Simple name references and definitions
alkane = ethane
hydroxyl = OH

# 2. Host fragment function reference
benzene_function = benzene.f

# 3. Single-bond connection and published host ports
phenol = benzene.f {
    s.1: OH.port.s.1
} {
    s.1: 0.s.1,
    s.2: 0.s.2
}

# 4. Multiple connections to numeric host positions
dihydroxybiphenyl = biphenyl.f {
    s.1: OH.port.s.1,
    s.2: OH.port.s.1
} {
    s.1: 0.s.1,
    s.2: 0.s.2
}

# 5. Multiple substitutions
substituted_ethane = ethane.f {
    s.1: nitro.port.s.1,
    s.2: OH.port.s.1,
    s.3: NH2.port.s.1
} {
    s.1: 0.s.2,
    s.2: 0.s.4
}

# 6. Nested structure applications
nested = benzene.f {
    s.1: benzene.port.s.1
} {
    s.1: 0.s.1,
    s.2: s.1.s.2
}

# 7. Single-bond guest port
single_connection = host.f {
    s.1: guest.port.s.1
} {
    s.1: 0.s.1,
    s.2: s.1.s.1
}

# 8. Double-bond guest port
double_connection = host.f {
    d.1: guest.port.d.2
} {
    d.1: 0.d.1,
    d.2: d.1.d.2
}

# 9. Triple-bond guest port
triple_connection = host.f {
    t.1: guest.port.t.2
} {
    t.1: 0.t.1,
    t.2: t.1.t.2
}

# 10. Several guest fragments
linked = host.f {
    s.1: left_fragment.port.s.1,
    s.2: right_fragment.port.s.2
} {
    s.1: 0.s.3,
    s.2: s.1.s.2,
    s.3: s.2.s.1
}

# 11. Empty connection group is allowed; publication group remains required
unconnected = host.f {} {
    s.1: 0.s.1,
    s.2: 0.s.2
}

# 12. A user-defined structure can be referenced as a guest
first = benzene.f {
    s.1: OH.port.s.1
} {
    s.1: 0.s.1,
    s.2: s.1.s.2
}

second = biphenyl.f {
    s.1: first.port.s.1
} {
    s.1: 0.s.1,
    s.2: s.1.s.2
}

# 13. Connections of different bond orders in one group
mixed = host.f {
    s.1: single_guest.port.s.1,
    d.1: double_guest.port.d.1,
    t.1: triple_guest.port.t.1
} {
    s.1: 0.s.4,
    d.1: 0.d.4,
    t.1: 0.t.4,
    s.2: s.1.s.2,
    s.3: d.1.s.2,
    s.4: t.1.s.2
}

# 14. Numeric port indices have no special locant semantics
numbered = host.f {
    s.4: guest_a.port.s.1,
    s.9: guest_b.port.s.1
} {
    s.1: 0.s.1,
    s.2: s.4.s.2,
    s.3: s.9.s.2
}

# 15. Ring closure: connect two ports within one structure
cyclohexane = ring(hexane, 1, 6)

# 16. Ring closure may be nested inside a definition
cyclic_fragment = ring(open_chain, 1, 2)
decorated_ring = benzene.f {
    s.1: cyclic_fragment.port.s.1
} {
    s.1: 0.s.1,
    s.2: s.1.s.2
}

# 17. Ring closure using a previously defined structure
open_chain = ethane.f {
    s.1: hydrogen.port.s.1
} {
    s.1: 0.s.2,
    s.2: s.1.s.2
}
closed_chain = ring(open_chain, 1, 6)

# 18. Example matching the proposed port-connection and publication syntax
port_export_example = host.f {
    s.1: guest.port.s.1,
    d.1: guest2.port.d.2
} {
    s.1: 0.s.2
}

# 19. Parser should reject non-numeric position/port labels
# Expected parser error: port index must be numeric.
invalid_named_position = host.f {
    para: guest.port.s.1
} {}

# 20. Parser should reject a malformed host port path
# Expected parser error: expected a port path such as s.1, d.1, or t.1.
invalid_host_port_path = host.f {
    q.1: guest.port.s.1
} {}

# 21. Parser should reject a malformed guest port selector
# Expected parser error: expected one of the supported selectors s, d, t.
invalid_guest_port_kind = host.f {
    s.1: guest.port.q.1
} {}

# 22. Parser should reject a missing guest port index
# Expected parser error: expected a numeric port index after the bond selector.
invalid_missing_guest_port_index = host.f {
    s.1: guest.port.s
} {}

# 23. Parser should reject a missing publication group
# Expected parser error: exactly two groups are required.
invalid_missing_publication_group = host.f {
    s.1: guest.port.s.1
}

# 24. Parser should reject malformed publication path syntax
# Expected parser error: expected a valid port path such as s.1 or 0.s.2.
invalid_publication_path = host.f {} {
    s.1: 0.q.1
}
