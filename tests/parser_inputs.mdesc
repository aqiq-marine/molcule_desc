# molcule_desc parser input fixtures
#
# Purpose:
#   Parser-level input examples only. These examples exercise the proposed
#   surface syntax. They are not semantic or chemical-validity tests.
#
# Current syntax decisions reflected here:
#   - Position labels are numeric only. Names such as para, ortho, and meta
#     are not valid position labels.
#   - A host fragment exposes a function using the form fragment.f.
#   - A guest fragment is supplied through a host function expression.
#   - Example shape: host.f {1: guest.port.s 2} {} {} {}
#   - Single-, double-, and triple-bond port groups are represented by argument
#     position, rather than by spelling out bond-order names at the call site.
#
# The exact grammar is still provisional. Names such as ethane, benzene, OH,
# and fragment are unresolved identifiers from the parser's point of view.

# 1. Simple name references and definitions
alkane = ethane
hydroxyl = OH

# 2. Host fragment function reference
benzene_function = benzene.f

# 3. Numeric position labels only
phenol = benzene.f {4: OH.port.s 1} {} {} {}

# 4. Multiple numeric positions
dihydroxybiphenyl = biphenyl.f {
    4: OH.port.s 1
    9: OH.port.s 1
} {} {} {}

# 5. Multiple substitutions on a structure with several available positions
substituted_ethane = ethane.f {
    1: nitro.port.s 1
    3: OH.port.s 1
    6: NH2.port.s 1
} {} {} {}

# 6. Nested structure applications
nested = benzene.f {
    4: benzene.port.s 1
} {} {} {}

# 7. Guest fragment port selected explicitly
single_connection = host.f {
    1: guest.port.s 2
} {} {} {}

# 8. Double-bond port selected explicitly
double_connection = host.f {
    1: guest.port.d 2
} {} {} {}

# 9. Triple-bond port selected explicitly
triple_connection = host.f {
    1: guest.port.t 2
} {} {} {}

# 10. Several guest fragments
linked = host.f {
    1: left_fragment.port.s 1
    2: right_fragment.port.s 2
} {} {} {}

# 11. The three trailing argument positions are present even when empty
single_only = host.f {
    1: guest.port.s 1
} {} {} {}

double_only = host.f {} {
    1: guest.port.d 1
} {} {}

triple_only = host.f {} {} {
    1: guest.port.t 1
} {}

# 12. A user-defined structure can be referenced as a guest
first = benzene.f {
    4: OH.port.s 1
} {} {} {}

second = biphenyl.f {
    4: first.port.s 1
} {} {} {}

# 13. More than one guest connection of different bond orders
mixed = host.f {
    1: single_guest.port.s 1
} {
    2: double_guest.port.d 1
} {
    3: triple_guest.port.t 1
} {}

# 14. Numeric labels remain numeric even when they resemble chemical locants
numbered = host.f {
    4: guest_a.port.s 1
    9: guest_b.port.s 1
} {} {} {}

# 15. Parser should reject non-numeric position labels
# Expected parser error: position label 'para' is not numeric.
invalid_named_position = benzene.f {para: OH.port.s 1} {} {} {}

# 16. Parser should reject missing position number after the colon
# Expected parser error: expected numeric position label.
invalid_missing_position = benzene.f {: OH.port.s 1} {} {} {}

# 17. Parser should reject malformed port selectors
# Expected parser error: expected one of the supported port selectors s, d, t.
invalid_port_kind = host.f {1: guest.port.q 2} {} {} {}

# 18. Parser should reject a missing argument group
# Expected parser error according to the current four-group call shape.
invalid_missing_group = host.f {1: guest.port.s 1} {} {}
